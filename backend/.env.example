PORT=5000
NODE_ENV=development

# Production PostgreSQL (Neon / Render)
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local PostgreSQL fallback (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=railmind_ai
DB_SSL=false

# Authentication
JWT_SECRET=replace_with_secure_random_secret

# Shared secret used by the simulator to discover active compressors
SIMULATOR_KEY=replace_with_secure_simulator_key
